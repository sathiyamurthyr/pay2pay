{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/register/layout,_N_T_/register/aadhaar/layout,_N_T_/register/aadhaar/page,_N_T_/register/aadhaar"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/register/aadhaar/__PAGE__",
    "/register/aadhaar",
    "/register",
    "/_index",
    "/_head"
  ]
}