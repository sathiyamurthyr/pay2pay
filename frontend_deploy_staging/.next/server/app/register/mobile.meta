{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/register/layout,_N_T_/register/mobile/layout,_N_T_/register/mobile/page,_N_T_/register/mobile"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/register/mobile/__PAGE__",
    "/register/mobile",
    "/register",
    "/_index",
    "/_head"
  ]
}