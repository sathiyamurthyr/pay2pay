{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/dist/layout,_N_T_/dist/onboarding/layout,_N_T_/dist/onboarding/page,_N_T_/dist/onboarding"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/dist/onboarding/__PAGE__",
    "/dist/onboarding",
    "/dist",
    "/_index",
    "/_head"
  ]
}