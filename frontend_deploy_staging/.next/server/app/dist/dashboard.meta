{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/dist/layout,_N_T_/dist/dashboard/layout,_N_T_/dist/dashboard/page,_N_T_/dist/dashboard"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/dist/dashboard/__PAGE__",
    "/dist/dashboard",
    "/dist",
    "/_index",
    "/_head"
  ]
}