{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/account-restricted/layout,_N_T_/account-restricted/page,_N_T_/account-restricted"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/account-restricted/__PAGE__",
    "/account-restricted",
    "/_index",
    "/_head"
  ]
}