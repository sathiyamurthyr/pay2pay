# Enterprise Retailer Payment Platform — Pay2Pay
# Bootstrap Environment Variables
# ============================================================
# ZERO plain-text secrets allowed in committed files.
# Run `python secrets_bootstrap.py` to populate .env from Bitwarden.
# ============================================================

APP_ENV=DEVELOPMENT

# ── Bitwarden Vault ─────────────────────────────────────────
BITWARDEN_SERVER=https://vault.bitwarden.com
BITWARDEN_CLIENT_ID=user.xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
BITWARDEN_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BITWARDEN_MASTER_PASSWORD=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Database (fetched from BW: "Pay2Pay — Supabase PostgreSQL Database") ────
DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname
ALEMBIC_DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname

# ── JWT Signing Keys (fetched from BW: "Pay2Pay — JWT Secret Keys") ─────────
SECRET_KEY=<64-char hex>
REFRESH_SECRET_KEY=<64-char hex>

# ── Backblaze B2 Storage (fetched from BW: "Pay2Pay — Backblaze B2 Storage") 
# Account: Sathus@SV162127 | Bucket: pay2pay
# Path format: cmp/{entity}/{year}/{month}/{day}/{uuid}_{filename}
#   cmp/                → Company docs
#   cmp/sd/             → Super Distributor KYC
#   cmp/dist/           → Distributor KYC
#   cmp/ret/            → Retailer KYC
#   cmp/service/        → Service / General
B2_KEY_ID=<your-b2-key-id>
B2_APP_KEY=<your-b2-application-key>
B2_BUCKET_NAME=pay2pay
