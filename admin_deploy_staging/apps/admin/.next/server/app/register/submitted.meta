{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/register/layout,_N_T_/register/submitted/layout,_N_T_/register/submitted/page,_N_T_/register/submitted"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/register/submitted/__PAGE__",
    "/register/submitted",
    "/register",
    "/_index",
    "/_head"
  ]
}