{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/register/layout,_N_T_/register/shop/layout,_N_T_/register/shop/page,_N_T_/register/shop"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/register/shop/__PAGE__",
    "/register/shop",
    "/register",
    "/_index",
    "/_head"
  ]
}