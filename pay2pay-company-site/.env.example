# ==============================================================================
# PAY2PAY COMPANY WEBSITE — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local for development or configure in your deployment.
# NEVER place sensitive database credentials, private keys, or API tokens here.
# ==============================================================================

# Public Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3005
NEXT_PUBLIC_SITE_NAME="Pay2Pay"
NEXT_PUBLIC_SITE_TAGLINE="Enterprise Digital Financial Services Platform"

# Role Authentication Portal Destinations
NEXT_PUBLIC_RETAILER_LOGIN_URL=https://retailer.pay2pay.in/retailer/login
NEXT_PUBLIC_DIT_LOGIN_URL=http://localhost:3000/dit-dashboard
NEXT_PUBLIC_SD_LOGIN_URL=http://localhost:3000/sd-dashboard
NEXT_PUBLIC_RETAILER_REGISTER_URL=http://localhost:3000/retailer/onboarding

# Corporate Contact Configuration
NEXT_PUBLIC_CONTACT_EMAIL=support@pay2pay.in
NEXT_PUBLIC_SUPPORT_PHONE=1800292982
NEXT_PUBLIC_WHATSAPP_NUMBER=+917013914767
NEXT_PUBLIC_GRIEVANCE_EMAIL=grievance@pay2pay.in

# Backend API Endpoint (Optional proxy integration)
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
